#. Translators: the "window" source in the target menu's start-tracking items.
msgid "window"
msgstr "finestra"

#. Translators: the "focus" source in the target menu's start-tracking items.
msgid "focus"
msgstr "focus"

#. Translators: the "mouse" source in the target menu's start-tracking items.
msgid "mouse pointer"
msgstr "mouse"

#. Translators: the "navigator object" source in the target menu's start-tracking items.
msgid "navigator object"
msgstr "oggetto navigatore"

#. Translators: a start-tracking item in the target menu, e.g. "Track window: Claude".
#, python-brace-format
msgid "Track {source}: {name}"
msgstr "Monitora {source}: {name}"

#. Translators: cancel whatever NVDA is saying to speak a change announcement at once.
msgid "I&nterrupt previous speech when announcing a new change"
msgstr "Int&errompi il parlato precedente all'annuncio di una nuova modifica"

#. Translators: suppress announcements of progress bar controls in a window.
msgid "Ignore &progress bars"
msgstr "Ignora le barre di &avanzamento"

#. Translators: suppress a control that does nothing but count (e.g. a timer).
msgid "Ignore c&ounters, steppers and timers"
msgstr "Ignora co&ntatori, progressioni e timer"

#. Translators: treat a window that renames itself as a target that has disappeared.
msgid "Consider c&hanged title a disappeared target"
msgstr "Considera un titolo cambiato come obiettivo &scomparso"

#. Translators: suppress standard controls such as Minimize, OK or Cancel buttons in a window.
msgid "Ignore kno&wn generic controls"
msgstr "Ignora i controlli &generici noti"

#. Translators: submenu item; read this one target while its own application is in the foreground.
msgid "Track this target even in the foreground"
msgstr "Traccia questo obiettivo anche in primo piano"

#. Translators: suppress announcements of the control the user is typing in.
msgid "Ignore the focu&sed control"
msgstr "Ignora il controllo con il &focus"

#. Translators: submenu item; keep this one target between NVDA restarts and re-attach it on reappearance.
msgid "Remember this target"
msgstr "Ricorda questo obiettivo"

#. Translators: submenu item; drop this one remembered target once it no longer exists.
msgid "Forget this target when it disappears"
msgstr "Dimentica questo obiettivo quando scompare"

#. Translators: submenu of a target's menu, holding that target's own settings.
msgid "Target settings"
msgstr "Impostazioni obiettivo"

#. Translators: submenu item that stops tracking a single target.
msgid "Stop tracking"
msgstr "Interrompi monitoraggio"

#. Translators: submenu item that moves the focus to a target.
msgid "Set focus"
msgstr "Imposta focus"

#. Translators: menu item that stops tracking every target at once.
msgid "Stop tracking all targets"
msgstr "Interrompi il monitoraggio di tutti gli obiettivi"

#. Translators: a dialog's OK button, never announced while "Ignore known generic controls" is on.
msgid "OK"
msgstr "OK"

#. Translators: a dialog's Cancel button, never announced while "Ignore known generic controls" is on.
msgid "Cancel"
msgstr "Annulla"

#. Translators: a button closing a window or dialog, never announced while "Ignore known generic
#. controls" is on.
msgid "Close"
msgstr "Chiudi"

#. Translators: a dialog's Abort button, never announced while "Ignore known generic controls" is on.
msgid "Abort"
msgstr "Interrompi"

#. Translators: a dialog's Retry button, never announced while "Ignore known generic controls" is on.
msgid "Retry"
msgstr "Riprova"

#. Translators: a dialog's Continue button, never announced while "Ignore known generic controls" is on.
msgid "Continue"
msgstr "Continua"

#. Translators: a wizard's button moving to its next page, never announced while "Ignore known
#. generic controls" is on.
msgid "Next"
msgstr "Avanti"

#. Translators: a button declining an offer or a prompt for now, never announced while "Ignore known
#. generic controls" is on.
msgid "Not now"
msgstr "Non ora"

#. Translators: a dialog's Yes button, never announced while "Ignore known generic controls" is on.
msgid "Yes"
msgstr "Sì"

#. Translators: a dialog's No button, never announced while "Ignore known generic controls" is on.
msgid "No"
msgstr "No"

#. Translators: a window's title bar button, never announced while "Ignore known generic controls" is on.
msgid "Minimize"
msgstr "Riduci a icona"

#. Translators: a window's title bar button, never announced while "Ignore known generic controls" is on.
msgid "Maximize"
msgstr "Ingrandisci"

#. Translators: the title bar button of a maximized window, never announced while "Ignore known
#. generic controls" is on.
msgid "Restore"
msgstr "Ripristina"

#. Translators: shown in the target menu, and spoken on demand, for a target
#. that does not currently exist (e.g. a remembered target not yet reopened).
msgid "not found"
msgstr "non trovato"

#. Translators: shown in the target menu, and spoken on demand, for a target
#. that has not changed since it was added, or is being looked at right now.
msgid "no changes yet"
msgstr "ancora nessuna modifica"

#. Translators: relative time for a change that has only just happened.
msgid "just now"
msgstr "proprio ora"

#. Translators: relative time in seconds. {n} is the number of seconds.
#, python-brace-format
msgid "{n} second ago"
msgid_plural "{n} seconds ago"
msgstr[0] "{n} secondo fa"
msgstr[1] "{n} secondi fa"

#. Translators: relative time in minutes. {n} is the number of minutes.
#, python-brace-format
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "{n} minuto fa"
msgstr[1] "{n} minuti fa"

#. Translators: relative time in hours. {n} is the number of hours.
#, python-brace-format
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "{n} ora fa"
msgstr[1] "{n} ore fa"

#. Translators: announced when tracking starts, e.g. "Tracking window: Claude".
#, python-brace-format
msgid "Tracking {target}"
msgstr "Monitoraggio di {target}"

#. Translators: announced at start-up or on resuming tracking when none of
#. the remembered targets are there.
msgid "No remembered targets found"
msgstr "Nessun obiettivo ricordato trovato"

#. Translators: announced at start-up or on resuming tracking when every
#. remembered target has been found, and there are few enough to name.
#. {n} is how many there are, {names} their names, separated by commas.
#, python-brace-format
msgid "Found {n} remembered target: {names}"
msgid_plural "Found {n} remembered targets: {names}"
msgstr[0] "Trovato {n} obiettivo ricordato: {names}"
msgstr[1] "Trovati {n} obiettivi ricordati: {names}"

#. Translators: announced at start-up or on resuming tracking when every
#. remembered target has been found. {n} is how many there are.
#, python-brace-format
msgid "Found {n} remembered target"
msgid_plural "Found {n} remembered targets"
msgstr[0] "Trovato {n} obiettivo ricordato"
msgstr[1] "Trovati {n} obiettivi ricordati"

#. Translators: announced at start-up or on resuming tracking when only some
#. of the remembered targets have been found; the rest are still being looked
#. for. {found} is how many are being tracked, {total} how many there are,
#. {names} the names of the ones found, separated by commas.
#, python-brace-format
msgid "Found {found} of {total} remembered targets: {names}"
msgstr "Trovati {found} obiettivi ricordati su {total}: {names}"

#. Translators: announced at start-up or on resuming tracking when only some
#. of the remembered targets have been found; the rest are still being looked
#. for. {found} is how many are being tracked, {total} how many there are.
#, python-brace-format
msgid "Found {found} of {total} remembered targets"
msgstr "Trovati {found} obiettivi ricordati su {total}"

#. Translators: announced when tracking stops, e.g. "Stopped tracking listbox: Message list".
#, python-brace-format
msgid "Stopped tracking {target}"
msgstr "Monitoraggio di {target} interrotto"

#. Translators: announced when a remembered target disappears and is kept in the
#. list to be tracked again once it reappears, e.g. "Target disappeared: Claude".
#, python-brace-format
msgid "Target disappeared: {target}"
msgstr "Obiettivo scomparso: {target}"

#. Translators: announced when a number key addresses an empty slot, e.g. "No target in slot 2".
#, python-brace-format
msgid "No target in slot {slot}"
msgstr "Nessun obiettivo nello slot {slot}"

#. Translators: announced when the whole target list is cleared at once.
msgid "All targets cleared"
msgstr "Tutti gli obiettivi rimossi"

#. Translators: announced when a command needs a target and none is being tracked.
msgid "No targets"
msgstr "Nessun obiettivo"

#. Translators: announced when "Set focus" cannot move the focus to a target (e.g. its window is gone).
msgid "Could not set focus"
msgstr "Impossibile impostare il focus"

#. Translators: announced when a second press would move the focus to a target that already has it.
msgid "This target already has focus"
msgstr "Questo obiettivo ha già il focus"

#. Translators: announced when background content tracking is paused.
msgid "Tracking paused"
msgstr "Monitoraggio sospeso"

#. Translators: announced when background content tracking is resumed.
msgid "Tracking resumed"
msgstr "Monitoraggio ripreso"

#. Translators: announced when the command overlay opens.
msgid "Overlay opened"
msgstr "Overlay aperto"

#. Translators: announced when the command overlay closes.
msgid "Overlay closed"
msgstr "Overlay chiuso"

#. Translators: announced when a key pressed in the overlay is not one of its commands.
msgid ""
"Unknown command. Press H once for help, twice to display the help as a "
"browseable message."
msgstr ""
"Comando sconosciuto. Premi H una volta per la guida, due volte per "
"visualizzare la guida come messaggio esplorabile."

#. Translators: the title of the add-on's category in NVDA's Settings dialog.
#. Translators: the category for this add-on's commands in the Input Gestures
#. dialog, and its title in the Settings dialog.
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
msgid "Background Content Tracker"
msgstr "Monitoraggio contenuti in background"

#. Translators: master switch; enables or disables all tracking.
msgid "Enable &tracking"
msgstr "Attiva il &monitoraggio"

#. Translators: group of options controlling what happens on a change.
msgid "When target changes"
msgstr "Quando l'obiettivo cambia"

#. Translators: play a tone when the target changes.
msgid "&Beep"
msgstr "&Bip"

#. Translators: speak an announcement when the target changes.
msgid "&Announce"
msgstr "&Annuncia"

#. Translators: how often, in seconds, targets are queried for changes
#. (0 means only display changes in the target menu, never announce them).
msgid ""
"Tracking &interval (seconds, 0 means never announce, only display in target "
"menu)"
msgstr ""
"&Intervallo di monitoraggio (secondi, 0 significa non annunciare mai, "
"mostrare solo nel menu degli obiettivi)"

#. Translators: how many consecutive changes to one target to announce in a
#. row before you have to refocus it (0 means announce every change). A target
#. the user is currently working in is never limited.
msgid ""
"Changes to announce at &once (background targets only, 0 means always "
"announce every change)"
msgstr ""
"Modifiche da annunciare in una &volta (solo obiettivi in background, 0 "
"significa annunciare sempre ogni modifica)"

#. Translators: also track a target while its own application is in the foreground.
msgid "Trac&k even foreground targets"
msgstr "&Traccia anche gli obiettivi in primo piano"

#. Translators: group of options refining how whole-window targets are announced.
msgid "Window tracking behavior"
msgstr "Comportamento del monitoraggio delle finestre"

#. Translators: suppress announcements of the control the user is typing in.
msgid "Ignore the focu&sed control when tracking the foreground window"
msgstr ""
"Ignora il controllo con il &focus durante il monitoraggio della finestra in "
"primo piano"

#. Translators: group of options for the beep, available when Beep is on.
msgid "Beep parameters"
msgstr "Parametri del bip"

#. Translators: how long the beep lasts, in milliseconds.
msgid "D&uration (ms)"
msgstr "D&urata (ms)"

#. Translators: the frequency of the beep, in hertz.
msgid "&Pitch (Hz)"
msgstr "&Altezza (Hz)"

#. Translators: plays a test beep with the current parameters.
msgid "&Test"
msgstr "&Prova"

#. Translators: group choosing what a change announcement contains.
msgid "Include in change announcement"
msgstr "Includi nell'annuncio delle modifiche"

#. Translators: include the target type (role) in change announcements.
msgid "Target t&ype"
msgstr "T&ipo di obiettivo"

#. Translators: include the changed content in change announcements.
msgid "Changed &content"
msgstr "&Contenuto modificato"

#. Translators: group choosing what a target menu description contains.
msgid "Include in menu descriptions"
msgstr "Includi nelle descrizioni del menu"

#. Translators: include the target type (role) in menu descriptions.
msgid "Targe&t type"
msgstr "Tipo di o&biettivo"

#. Translators: include the time since the last change in menu descriptions.
msgid "Time since last chan&ge"
msgstr "Tempo dall'ultima &modifica"

#. Translators: include the changed content in menu descriptions.
msgid "Changed cont&ent"
msgstr "Contenuto modi&ficato"

#. Translators: how many seconds of inactivity close the command overlay
#. (0 means the overlay stays open until it is closed by a command or escape).
msgid "&Overlay timeout (seconds, 0 means never time out)"
msgstr "Timeout dell'&overlay (secondi, 0 significa nessun timeout)"

#. Translators: a target order; the most recently added target comes first.
msgid "Newest target first"
msgstr "Prima l'obiettivo più recente"

#. Translators: a target order; the target added longest ago comes first.
msgid "Oldest target first"
msgstr "Prima l'obiettivo più vecchio"

#. Translators: a target order; the target that changed last comes first.
msgid "Most recently changed target first"
msgstr "Prima l'obiettivo modificato più di recente"

#. Translators: a target order; the target that changed longest ago comes first.
msgid "Least recently changed target first"
msgstr "Prima l'obiettivo modificato meno di recente"

#. Translators: a target order; targets by name, A to Z.
msgid "Alphabetically, A to Z"
msgstr "In ordine alfabetico, dalla A alla Z"

#. Translators: a target order; targets by name, Z to A.
msgid "Alphabetically, Z to A"
msgstr "In ordine alfabetico, dalla Z alla A"

#. Translators: the order the targets take the ten number slots in.
msgid "Target slot sorting"
msgstr "Ordinamento degli obiettivi negli slot"

#. Translators: the order the targets are listed in, in the target menu.
msgid "Target menu sorting"
msgstr "Ordinamento degli obiettivi nel menu degli obiettivi"

#. Translators: keep the target list between NVDA restarts and re-attach on reappearance.
msgid "&Remember targets"
msgstr "&Ricorda gli obiettivi"

#. Translators: automatically drop remembered targets that no longer exist.
msgid "&Forget remembered targets when they disappear"
msgstr "&Dimentica gli obiettivi ricordati quando scompaiono"

#. Translators: the description of the main command, shown in Input Gestures.
msgid ""
"Opens the Background Content Tracker command overlay: press and release, "
"then press a command key (H for help)"
msgstr ""
"Apre l'overlay dei comandi di Monitoraggio contenuti in background: premi e "
"rilascia, quindi premi un tasto comando (premi H per la guida)"

#. Translators: heading of the overlay help.
msgid "Background Content Tracker commands"
msgstr "Comandi di Monitoraggio contenuti in background"

#. Translators: overlay help line for the H key.
msgid "H: this help"
msgstr "H: questa guida"

#. Translators: overlay help line for the W key.
msgid "W: start or stop tracking the current window"
msgstr "W: avvia o interrompe il monitoraggio della finestra corrente"

#. Translators: overlay help line for the F key.
msgid "F: start or stop tracking the focused control"
msgstr "F: avvia o interrompe il monitoraggio del controllo con focus"

#. Translators: overlay help line for the M key.
msgid "M: start or stop tracking the control under the mouse pointer"
msgstr "M: avvia o interrompe il monitoraggio del controllo sotto il mouse"

#. Translators: overlay help line for the N key.
msgid "N: start or stop tracking the navigator object"
msgstr "N: avvia o interrompe il monitoraggio dell'oggetto navigatore"

#. Translators: overlay help line for shift and control with W, F, M or N.
msgid ""
"Add shift to W, F, M or N to remember that one target, control to read it "
"even in the foreground, or both"
msgstr ""
"Con Maiusc, W, F, M o N ricorda proprio quell'obiettivo, con Control lo "
"monitora anche in primo piano, con entrambi entrambe le cose"

#. Translators: overlay help line for the T key.
msgid "T: open the target menu"
msgstr "T: apre il menu degli obiettivi"

#. Translators: overlay help line for the number keys.
msgid ""
"1 through 0: speak information about the target in that slot; press again to "
"set focus to it"
msgstr ""
"Da 1 a 0: annuncia le informazioni sull'obiettivo in quello slot; premi di "
"nuovo per impostare il focus su di esso"

#. Translators: overlay help line for Space and Enter.
msgid ""
"Space or Enter: speak information about the most recently added target; "
"press again to set focus to it"
msgstr ""
"Spazio o Invio: annuncia le informazioni sull'obiettivo aggiunto più di "
"recente; premi di nuovo per impostare il focus su di esso"

#. Translators: overlay help line for Control plus a number.
msgid "Control plus a number: stop tracking the target in that slot"
msgstr ""
"Control più un numero: interrompe il monitoraggio dell'obiettivo in quello "
"slot"

#. Translators: overlay help line for Backspace.
msgid "Backspace: stop tracking the most recently added target"
msgstr ""
"Backspace: interrompe il monitoraggio dell'obiettivo aggiunto più di recente"

#. Translators: overlay help line for Delete.
msgid "Delete: stop tracking all targets"
msgstr "Canc: interrompe il monitoraggio di tutti gli obiettivi"

#. Translators: overlay help line for the P key.
msgid "P: pause or resume all tracking"
msgstr "P: sospende o riprende tutto il monitoraggio"

#. Translators: overlay help line for the S key.
msgid "S: open the add-on settings"
msgstr "S: apre le impostazioni del componente aggiuntivo"

#. Translators: overlay help line for the I key.
msgid "I: open the add-on input gestures"
msgstr "I: apre i gesti di immissione del componente aggiuntivo"

#. Translators: overlay help line for the Escape key.
msgid "Escape: close the overlay"
msgstr "Escape: chiude l'overlay"

#. Translators: Long description to be shown for this add-on on add-on information from add-on store
msgid ""
"Tracks windows or individual controls in the background and notifies you "
"when they change."
msgstr ""
"Monitora finestre o singoli controlli in background e ti avvisa quando "
"cambiano."

#. Translators: what's new content for the add-on version to be shown in the add-on store
msgid "Initial release"
msgstr "Versione iniziale"
