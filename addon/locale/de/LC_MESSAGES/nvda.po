#. Translators: the "window" source in the target menu's start-tracking items.
#: addon\globalPlugins\backgroundContentTracker\menu.py:42
msgid "window"
msgstr "Fenster"

#. Translators: the "focus" source in the target menu's start-tracking items.
#: addon\globalPlugins\backgroundContentTracker\menu.py:44
msgid "focus"
msgstr "Fokus"

#. Translators: the "mouse" source in the target menu's start-tracking items.
#: addon\globalPlugins\backgroundContentTracker\menu.py:46
msgid "mouse pointer"
msgstr "Maus"

#. Translators: the "navigator object" source in the target menu's start-tracking items.
#: addon\globalPlugins\backgroundContentTracker\menu.py:48
msgid "navigator object"
msgstr "Navigatorobjekt"

#. Translators: a start-tracking item in the target menu, e.g. "Track window: Claude".
#: addon\globalPlugins\backgroundContentTracker\menu.py:52
#, python-brace-format
msgid "Track {source}: {name}"
msgstr "{source} verfolgen: {name}"

#. Translators: submenu item that stops tracking a single target.
#: addon\globalPlugins\backgroundContentTracker\menu.py:71
msgid "Stop tracking"
msgstr "Verfolgung stoppen"

#. Translators: submenu item that moves the focus to a target.
#: addon\globalPlugins\backgroundContentTracker\menu.py:74
msgid "Set focus"
msgstr "Fokus setzen"

#. Translators: menu item that stops tracking every target at once.
#: addon\globalPlugins\backgroundContentTracker\menu.py:90
msgid "Stop tracking all targets"
msgstr "Verfolgung aller Ziele stoppen"

#. Translators: shown in the target menu when a target has not changed yet.
#. Translators: on-demand target info when there is nothing new to report.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:42
#: addon\globalPlugins\backgroundContentTracker\notifier.py:96
msgid "no changes yet"
msgstr "noch keine Änderungen"

#. Translators: relative time for a change that has only just happened.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:46
msgid "just now"
msgstr "gerade eben"

#. Translators: relative time in seconds. {n} is the number of seconds.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:49
#, python-brace-format
msgid "{n} second ago"
msgid_plural "{n} seconds ago"
msgstr[0] "vor {n} Sekunde"
msgstr[1] "vor {n} Sekunden"

#. Translators: relative time in minutes. {n} is the number of minutes.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:53
#, python-brace-format
msgid "{n} minute ago"
msgid_plural "{n} minutes ago"
msgstr[0] "vor {n} Minute"
msgstr[1] "vor {n} Minuten"

#. Translators: relative time in hours. {n} is the number of hours.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:57
#, python-brace-format
msgid "{n} hour ago"
msgid_plural "{n} hours ago"
msgstr[0] "vor {n} Stunde"
msgstr[1] "vor {n} Stunden"

#. Translators: announced when tracking starts, e.g. "Tracking window: Claude".
#. Queued rather than interrupting: several remembered targets are
#. re-attached in a quick loop at start-up, and an interrupting message
#. would leave only the last one audible.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:69
#, python-brace-format
msgid "Tracking {target}"
msgstr "Verfolge {target}"

#. Translators: announced when tracking stops, e.g. "Stopped tracking listbox: Message list".
#: addon\globalPlugins\backgroundContentTracker\notifier.py:74
#, python-brace-format
msgid "Stopped tracking {target}"
msgstr "Verfolgung von {target} beendet"

#. Translators: announced when a number key addresses an empty slot, e.g. "No target in slot 2".
#: addon\globalPlugins\backgroundContentTracker\notifier.py:126
#, python-brace-format
msgid "No target in slot {slot}"
msgstr "Kein Ziel in Fach {slot}"

#. Translators: announced when the whole target list is cleared at once.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:130
msgid "All targets cleared"
msgstr "Alle Ziele entfernt"

#. Translators: announced (on resume and at start-up) when there are no valid targets.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:134
msgid "No targets to track"
msgstr "Keine Ziele zum Verfolgen"

#. Translators: announced when "Set focus" cannot move the focus to a target (e.g. its window is gone).
#: addon\globalPlugins\backgroundContentTracker\notifier.py:138
msgid "Could not move focus to the target"
msgstr "Der Fokus konnte nicht zum Ziel bewegt werden"

#. Translators: announced when background content tracking is paused.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:142
msgid "Background content tracking disabled"
msgstr "Hintergrund-Inhaltsverfolgung deaktiviert"

#. Translators: announced when background content tracking is resumed.
#: addon\globalPlugins\backgroundContentTracker\notifier.py:146
msgid "Background content tracking enabled"
msgstr "Hintergrund-Inhaltsverfolgung aktiviert"

#. Translators: announced when the command overlay opens. "H" is the help key.
#: addon\globalPlugins\backgroundContentTracker\overlay.py:113
msgid "Background Content Tracker, H for help"
msgstr "Hintergrund-Inhaltsverfolgung, H für Hilfe"

#. Translators: announced when the command overlay closes.
#: addon\globalPlugins\backgroundContentTracker\overlay.py:141
msgid "Overlay closed"
msgstr "Überlagerung geschlossen"

#. Translators: announced when a key pressed in the overlay is not one of its commands.
#: addon\globalPlugins\backgroundContentTracker\overlay.py:240
msgid "Unknown command, press H for help."
msgstr "Unbekannter Befehl, drücken Sie H für Hilfe."

#. Translators: the title of the add-on's category in NVDA's Settings dialog.
#. Translators: the category for this add-on's commands in the Input Gestures
#. dialog, and its title in the Settings dialog.
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\backgroundContentTracker\settings.py:31
#: addon\globalPlugins\backgroundContentTracker\__init__.py:106
#: addon\globalPlugins\backgroundContentTracker\__init__.py:311 buildVars.py:21
msgid "Background Content Tracker"
msgstr "Hintergrund-Inhaltsverfolgung"

#. Translators: master switch; enables or disables all tracking.
#: addon\globalPlugins\backgroundContentTracker\settings.py:37
msgid "Enable background content &tracking"
msgstr "Hintergrund-Inhalts&verfolgung aktivieren"

#. Group: When target changes -----------------------------------------
#. Translators: group of options controlling what happens on a change.
#: addon\globalPlugins\backgroundContentTracker\settings.py:42
msgid "When target changes"
msgstr "Wenn sich ein Ziel ändert"

#. Translators: play a tone when the target changes.
#: addon\globalPlugins\backgroundContentTracker\settings.py:45
msgid "&Beep"
msgstr "&Signalton"

#. Translators: speak an announcement when the target changes.
#: addon\globalPlugins\backgroundContentTracker\settings.py:49
msgid "&Announce"
msgstr "&Ansagen"

#. Translators: how often, in seconds, targets are queried for changes
#. (0 means only display changes in the target menu, never announce them).
#: addon\globalPlugins\backgroundContentTracker\settings.py:55
msgid "Tracking &interval (seconds)"
msgstr "Verfolgungs&intervall (Sekunden)"

#. Translators: how many consecutive changes to one target to announce in a
#. row before you have to refocus it (0 means announce every change).
#: addon\globalPlugins\backgroundContentTracker\settings.py:61
msgid "Changes to announce at &once"
msgstr "Auf &einmal anzusagende Änderungen"

#. Group: Window tracking behavior ------------------------------------
#. Translators: group of options refining how whole-window targets are announced.
#: addon\globalPlugins\backgroundContentTracker\settings.py:67
msgid "Window tracking behavior"
msgstr "Verhalten bei Fensterverfolgung"

#. Translators: suppress announcements of progress bar controls in a window.
#: addon\globalPlugins\backgroundContentTracker\settings.py:70
msgid "Ignore &progress bars"
msgstr "&Fortschrittsbalken ignorieren"

#. Translators: suppress repeated announcements of the same control (e.g. a timer).
#: addon\globalPlugins\backgroundContentTracker\settings.py:73
msgid "Ignore &repeatedly changing controls"
msgstr "&Wiederholt ändernde Steuerelemente ignorieren"

#. Translators: treat a window that renames itself as a target that has disappeared.
#: addon\globalPlugins\backgroundContentTracker\settings.py:76
msgid "Consider c&hanged title a disappeared target"
msgstr "Geänderten Titel als verschwundenes Ziel &betrachten"

#. Group: Beep parameters ---------------------------------------------
#. Translators: group of options for the beep, available when Beep is on.
#: addon\globalPlugins\backgroundContentTracker\settings.py:81
msgid "Beep parameters"
msgstr "Signalton-Parameter"

#: addon\globalPlugins\backgroundContentTracker\settings.py:85
msgid "D&uration (ms)"
msgstr "Da&uer (ms)"

#: addon\globalPlugins\backgroundContentTracker\settings.py:90
msgid "&Pitch (Hz)"
msgstr "&Tonhöhe (Hz)"

#. Translators: plays a test beep with the current parameters.
#: addon\globalPlugins\backgroundContentTracker\settings.py:94
msgid "&Test"
msgstr "&Testen"

#. Group: Include in change announcement -------------------------------
#. Translators: group choosing what a change announcement contains.
#: addon\globalPlugins\backgroundContentTracker\settings.py:99
msgid "Include in change announcement"
msgstr "In Änderungsansage einbeziehen"

#. Translators: include the target type (role) in change announcements.
#: addon\globalPlugins\backgroundContentTracker\settings.py:102
msgid "Target t&ype"
msgstr "Ziel&typ"

#. Translators: include the changed content in change announcements.
#: addon\globalPlugins\backgroundContentTracker\settings.py:105
msgid "Changed &content"
msgstr "Geänderter &Inhalt"

#. Group: Include in menu descriptions --------------------------------
#. Translators: group choosing what a target menu description contains.
#: addon\globalPlugins\backgroundContentTracker\settings.py:110
msgid "Include in menu descriptions"
msgstr "In Menübeschreibungen einbeziehen"

#. Translators: include the target type (role) in menu descriptions.
#: addon\globalPlugins\backgroundContentTracker\settings.py:113
msgid "Targe&t type"
msgstr "Zielt&yp"

#. Translators: include the time since the last change in menu descriptions.
#: addon\globalPlugins\backgroundContentTracker\settings.py:116
msgid "Time since last chan&ge"
msgstr "Zeit seit letzter Änderun&g"

#. Translators: include the changed content in menu descriptions.
#: addon\globalPlugins\backgroundContentTracker\settings.py:119
msgid "Changed cont&ent"
msgstr "Geänderter Inhal&t"

#. Translators: how many seconds of inactivity close the command overlay.
#: addon\globalPlugins\backgroundContentTracker\settings.py:124
msgid "&Overlay timeout (seconds)"
msgstr "&Überlagerungs-Timeout (Sekunden)"

#. Translators: target sorting option (the default).
#: addon\globalPlugins\backgroundContentTracker\settings.py:131
msgid "Oldest first"
msgstr "Älteste zuerst"

#. Translators: target sorting option.
#: addon\globalPlugins\backgroundContentTracker\settings.py:133
msgid "Newest first"
msgstr "Neueste zuerst"

#. Translators: label for the target sorting radio buttons.
#: addon\globalPlugins\backgroundContentTracker\settings.py:137
msgid "Target sorting"
msgstr "Zielsortierung"

#. Translators: also track a target while its own application is in the foreground.
#: addon\globalPlugins\backgroundContentTracker\settings.py:143
msgid "Trac&k even foreground targets"
msgstr "Ziele auch im Vor&dergrund verfolgen"

#. Translators: keep the target list between NVDA restarts and re-attach on reappearance.
#: addon\globalPlugins\backgroundContentTracker\settings.py:147
msgid "&Remember targets"
msgstr "Ziele &merken"

#. Translators: automatically drop targets that no longer exist.
#: addon\globalPlugins\backgroundContentTracker\settings.py:151
msgid "&Forget targets when they disappear"
msgstr "Ziele &vergessen, wenn sie verschwinden"

#: addon\globalPlugins\backgroundContentTracker\__init__.py:212
msgid ""
"Opens the Background Content Tracker command overlay: press and release it, "
"then press a command key (H for help)"
msgstr ""
"Öffnet die Befehlsüberlagerung der Hintergrund-Inhaltsverfolgung: drücken "
"und loslassen, dann eine Befehlstaste drücken (H für Hilfe)"

#. Translators: heading of the overlay help.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:271
msgid "Background Content Tracker commands"
msgstr "Befehle der Hintergrund-Inhaltsverfolgung"

#. Translators: overlay help line for the H key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:274
msgid "H: this help"
msgstr "H: diese Hilfe"

#. Translators: overlay help line for the W key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:276
msgid "W: start or stop tracking the current window"
msgstr "W: Verfolgung des aktuellen Fensters starten oder stoppen"

#. Translators: overlay help line for the F key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:278
msgid "F: start or stop tracking the focused control"
msgstr "F: Verfolgung des fokussierten Steuerelements starten oder stoppen"

#. Translators: overlay help line for the M key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:280
msgid "M: start or stop tracking the control under the mouse pointer"
msgstr "M: Verfolgung des Steuerelements unter der Maus starten oder stoppen"

#. Translators: overlay help line for the N key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:282
msgid "N: start or stop tracking the navigator object"
msgstr "N: Verfolgung des Navigatorobjekts starten oder stoppen"

#. Translators: overlay help line for shift and control with W, F, M or N.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:284
msgid ""
"Add shift to any of W, F, M or N to remember that one target, control to "
"read it even in the foreground, or both"
msgstr ""
"Mit Umschalt merkt sich W, F, M oder N genau dieses eine Ziel, mit Strg "
"wird es auch im Vordergrund verfolgt, mit beiden beides"

#. Translators: overlay help line for the T key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:286
msgid "T: open the target menu"
msgstr "T: das Zielmenü öffnen"

#. Translators: overlay help line for the number keys.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:288
msgid ""
"1 through 0: speak information about the target in that slot; press again to "
"move focus to it"
msgstr ""
"1 bis 0: Informationen über das Ziel in diesem Fach ansagen; erneut drücken, "
"um den Fokus dorthin zu bewegen"

#. Translators: overlay help line for Space and Enter.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:290
msgid "Space or Enter: the most recently added target"
msgstr "Leertaste oder Eingabetaste: das zuletzt hinzugefügte Ziel"

#. Translators: overlay help line for Control plus a number.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:292
msgid "Control plus a number: stop tracking the target in that slot"
msgstr "Strg plus eine Zahl: Verfolgung des Ziels in diesem Fach stoppen"

#. Translators: overlay help line for Backspace.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:294
msgid "Backspace: stop tracking the most recently added target"
msgstr "Rücktaste: Verfolgung des zuletzt hinzugefügten Ziels stoppen"

#. Translators: overlay help line for Delete.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:296
msgid "Delete: stop tracking all targets"
msgstr "Entf: Verfolgung aller Ziele stoppen"

#. Translators: overlay help line for the P key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:298
msgid "P: pause or resume all tracking"
msgstr "P: die gesamte Verfolgung pausieren oder fortsetzen"

#. Translators: overlay help line for the S key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:300
msgid "S: open the add-on settings"
msgstr "S: die Add-on-Einstellungen öffnen"

#. Translators: overlay help line for the I key.
#: addon\globalPlugins\backgroundContentTracker\__init__.py:302
msgid "I: open the add-on input gestures"
msgstr "I: die Tastenzuordnungen des Add-ons öffnen"

#: buildVars.py:25
msgid ""
"Tracks windows or individual controls in the background and notifies you "
"when they change."
msgstr ""
"Verfolgt Fenster oder einzelne Steuerelemente im Hintergrund und "
"benachrichtigt Sie, wenn sie sich ändern."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:31
msgid "Initial release"
msgstr "Erste Veröffentlichung"
